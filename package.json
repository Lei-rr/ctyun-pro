{
  "name": "ctyun-pro",
  "version": "1.0.0",
  "description": "天翼云电脑智能保活管理系统 Pro (多账号多电脑 | shadcn-vue 前端 | 智能 OCR + 人工双模)",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm --workspace web run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js",
    "build:web": "npm --workspace web run build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
